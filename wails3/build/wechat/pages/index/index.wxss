.page {
  min-height: 100vh;
  background: #f5f5f7;
}

.search-bar {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 16px;
  background: #fff;
}

.search-input {
  flex: 1;
  height: 40px;
  padding: 0 12px;
  border-radius: 20px;
  background: #f0f0f3;
  font-size: 14px;
}

.search-btn {
  background: linear-gradient(135deg, #ec4899, #8b5cf6);
  color: #fff;
  font-size: 14px;
  border-radius: 20px;
  line-height: 2.4;
}

.hint {
  padding: 48px 16px;
  text-align: center;
  color: #999;
  font-size: 14px;
}
