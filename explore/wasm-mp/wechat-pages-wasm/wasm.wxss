.page { padding: 20rpx; background: #f5f5f7; min-height: 100vh; }
.head { display: flex; gap: 16rpx; align-items: center; margin-bottom: 24rpx; }
.kw { flex: 1; background: #fff; border-radius: 12rpx; padding: 16rpx 20rpx; font-size: 28rpx; }
.btn { flex-shrink: 0; }
.status { text-align: center; color: #999; font-size: 26rpx; padding: 40rpx 0; }
.list { display: flex; flex-direction: column; gap: 16rpx; }
.card { display: flex; gap: 20rpx; background: #fff; border-radius: 16rpx; padding: 16rpx; align-items: center; box-shadow: 0 1rpx 6rpx rgba(0,0,0,.05); }
.cover { width: 120rpx; height: 120rpx; border-radius: 12rpx; flex-shrink: 0; }
.info { flex: 1; overflow: hidden; }
.title { font-size: 28rpx; font-weight: 600; color: #222; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.meta { font-size: 22rpx; color: #999; margin-top: 8rpx; }
.play { width: 64rpx; height: 64rpx; border-radius: 50%; background: #fa2c19; color: #fff; text-align: center; line-height: 64rpx; font-size: 24rpx; flex-shrink: 0; }
.empty { text-align: center; color: #bbb; font-size: 26rpx; padding: 60rpx 0; }
.err { color: #e33; font-size: 24rpx; background: #fff3f3; border-radius: 8rpx; padding: 16rpx; margin-bottom: 20rpx; word-break: break-all; }
